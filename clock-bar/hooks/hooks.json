{
  "hooks": {
    "SessionStart":     [{"hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/clockbar.py\" brief"}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/clockbar.py\" busy"}]}],
    "PostToolUse":      [{"hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/clockbar.py\" tick"}]}],
    "PreToolUse":       [{"matcher": "AskUserQuestion", "hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/clockbar.py\" wait"}]}],
    "Notification":     [{"hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/clockbar.py\" wait"}]}],
    "SubagentStart":    [{"hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/clockbar.py\" agent-start"}]}],
    "SubagentStop":     [{"hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/clockbar.py\" agent-stop"}]}],
    "Stop":             [{"hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/clockbar.py\" ready"}]}]
  }
}
